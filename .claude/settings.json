{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)"
    ],
    "deny": [
      "Bash(git *push*--force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push* +*)",
      "Bash(git *push*--mirror*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-force-push.mjs\""
          }
        ]
      }
    ]
  }
}
